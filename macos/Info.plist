<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleIdentifier</key><string>org.openbridge.macos</string>
    <key>CFBundleName</key><string>OpenBridge</string>
    <key>CFBundleDisplayName</key><string>OpenBridge</string>
    <key>CFBundleExecutable</key><string>OpenBridge</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.1.1</string>
    <key>CFBundleVersion</key><string>26</string>
    <key>LSMinimumSystemVersion</key><string>13.0</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSBonjourServices</key><array><string>_openbridge._tcp</string></array>
    <key>NSLocalNetworkUsageDescription</key><string>OpenBridge connects to your Android phone to transfer files on your local network.</string>
    <!-- Drop files on the Dock icon, or Open With › OpenBridge, to send them to the phone. Never the default app. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key><string>Any file</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>public.data</string><string>public.content</string></array>
        </dict>
    </array>
    <!-- Services › Send to Phone with OpenBridge: files, links (open on the phone) and text (the phone's clipboard). -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>Send to Phone with OpenBridge</string></dict>
            <key>NSMessage</key><string>sendToPhone</string>
            <key>NSPortName</key><string>OpenBridge</string>
            <key>NSRequiredContext</key><dict/>
            <key>NSSendTypes</key><array><string>public.utf8-plain-text</string><string>public.url</string><string>public.file-url</string></array>
            <key>NSSendFileTypes</key><array><string>public.data</string><string>public.content</string></array>
        </dict>
    </array>
</dict></plist>
